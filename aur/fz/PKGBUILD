pkgname=('fz' 'fzr')
pkgver=0.2
pkgrel=1
arch=('x86_64')
makedepends=('go')

source=("https://github.com/SlushyLint/fzyFS/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0532e52cec2bf022667cb9775b72a65a900789781bde75b4775d97e8d8500ebe')

build() {
    cd "$srcdir/fzyFS-$pkgver"

    cd fz
    go build -o "$srcdir/fz" .

    cd ../fzr
    go build -o "$srcdir/fzr" .
}

package_fz() {
    install -Dm755 "$srcdir/fz" "$pkgdir/usr/bin/fz"
}

package_fzr() {
    install -Dm755 "$srcdir/fzr" "$pkgdir/usr/bin/fzr"
}
